# PPT Master MCP Server 环境变量
# ============================================================
# 复制为 .env 后按需修改
#   cp .env.example .env

# MCP Server 绑定地址和端口
MCP_HOST=0.0.0.0
MCP_PORT=8011

# 工作区存储目录（默认 ./workspaces，Docker 中已挂载为 Volume）
WORKSPACES_DIR=./workspaces

# ppt-master 项目路径（默认 ./ppt-master-main）
PPT_MASTER_PATH=./ppt-master-main

# --- 离线/在线模式开关 ---

# 离线模式（true/false）。开启后关闭以下功能：
#   - AI 图像生成（PPT_IMAGE_GEN_ENABLED 自动生效为 false）
#   - URL 网页抓取解析（ppt_parse_source 的 URL 模式不可用）
#   - 语音旁白合成
# 默认 false，内网离线部署时设为 true
PPT_OFFLINE_MODE=false

# AI 图像生成开关（true/false）
# 依赖 PPT_OFFLINE_MODE=false 时才有效
# 开启后需在 ppt-master-main/.env 中配置对应后端的 API Key
PPT_IMAGE_GEN_ENABLED=false

# 语音旁白合成开关（true/false）
# 依赖 PPT_OFFLINE_MODE=false 时才有效
PPT_AUDIO_ENABLED=false
