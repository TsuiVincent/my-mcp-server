# ============================================================
# PPT Master MCP Server 环境变量
# ============================================================
# 复制为 .env 后修改，docker-compose.yml 通过 env_file 读取
# 内网部署：修改 *_BASE_URL 指向内网服务即可

# ── MCP Server ──
MCP_HOST=0.0.0.0
MCP_PORT=8011
WORKSPACES_DIR=./workspaces
PPT_MASTER_PATH=./ppt-master-main

# ── 功能开关 ──
PPT_IMAGE_GEN_ENABLED=false      # AI 生图（配好 API Key 后改为 true）
PPT_AUDIO_ENABLED=false          # 音频旁白（部署内网 TTS 后开启）

# ============================================================
# AI 图像生成配置
# ============================================================
# 激活后端（开放时 PPT_IMAGE_GEN_ENABLED=true，并择一设置）：
#   openai / gemini / zhipu / qwen / volcengine / minimax /
#   siliconflow / stability / bfl / ideogram / fal /
#   replicate / openrouter / modelscope
# IMAGE_BACKEND=openai

# 最大并发（--manifest 批量模式，默认 3）
# IMAGE_CONCURRENCY=3

# ── OpenAI / OpenAI 兼容 ──
# IMAGE_BACKEND=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-image-2
# OPENAI_BASE_URL=http://内网IP:8080/v1     # 指向内网模型服务
# 可选兼容参数（OpenAI 兼容第三方平台可能需要）：
# OPENAI_SIZE_PRESET=auto
# OPENAI_RESPONSE_FORMAT=auto
# OPENAI_QUALITY=auto
# OPENAI_OUTPUT_FORMAT=png                 # png / jpeg / webp
# OPENAI_OUTPUT_COMPRESSION=80             # jpeg/webp only, 0-100
# OPENAI_BACKGROUND=auto                   # gpt-image-2: auto / opaque
# OPENAI_MODERATION=auto                   # auto / low

# ── Gemini ──
# IMAGE_BACKEND=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-image-preview
# GEMINI_BASE_URL=https://your-proxy-url.com

# ── 智谱 ──
# IMAGE_BACKEND=zhipu
# ZHIPU_API_KEY=your-zhipu-key
# ZHIPU_MODEL=glm-image
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations

# ── 通义 ──
# IMAGE_BACKEND=qwen
# QWEN_API_KEY=your-dashscope-key
# QWEN_MODEL=qwen-image-2.0-pro
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis

# ── 火山引擎 ──
# IMAGE_BACKEND=volcengine
# VOLCENGINE_API_KEY=your-volcengine-key
# VOLCENGINE_MODEL=doubao-seedream-4-5-251128
# VOLCENGINE_BASE_URL=https://operator.las.cn-beijing.volces.com/api/v1/images/generations

# ── MiniMax ──
# IMAGE_BACKEND=minimax
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_MODEL=image-01
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1/image_generation

# ── SiliconFlow ──
# IMAGE_BACKEND=siliconflow
# SILICONFLOW_API_KEY=your-siliconflow-key
# SILICONFLOW_MODEL=Qwen/Qwen-Image
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/images/generations

# ── 其他后端 ──
# STABILITY_API_KEY=xxx         # Stability AI
# STABILITY_MODEL=stable-image-core
# STABILITY_BASE_URL=https://api.stability.ai
#
# BFL_API_KEY=xxx               # Black Forest Labs
# BFL_MODEL=flux-pro-1.1-ultra
# BFL_BASE_URL=https://api.bfl.ai
#
# IDEOGRAM_API_KEY=xxx          # Ideogram
# IDEOGRAM_MODEL=ideogram-v3
# IDEOGRAM_BASE_URL=https://api.ideogram.ai
#
# OPENROUTER_API_KEY=xxx        # OpenRouter
# OPENROUTER_MODEL=google/gemini-3.1-flash-image-preview
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# MODELSCOPE_API_KEY=xxx        # ModelScope
# MODELSCOPE_MODEL=Tongyi-MAI/Z-Image-Turbo
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# ============================================================
# 音频旁白 TTS 配置（notes_to_audio.py）
# ============================================================
# edge-tts 是默认后端，无需 API Key（需外网访问微软 TTS）
# 内网部署时切换到其他后端：

# ── ElevenLabs ──
# ELEVENLABS_API_KEY=xxx

# ── MiniMax TTS ──
# MINIMAX_API_KEY=xxx
# MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1/t2a_v2

# ── 通义 Qwen TTS ──
# QWEN_API_KEY=your-dashscope-key
# QWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# ── CosyVoice（阿里，需 DashScope Key）──
# DASHSCOPE_API_KEY=your-dashscope-key
# COSYVOICE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# ============================================================
# 网络图片搜索配置（image_search.py）
# ============================================================
# Openverse / Wikimedia 无需 Key 但质量不稳定
# 推荐配置 Pexels / Pixabay 获取稳定商业图库质量

# PEXELS_API_KEY=your-pexels-key       # https://www.pexels.com/api/
# PIXABAY_API_KEY=your-pixabay-key     # https://pixabay.com/api/docs/
